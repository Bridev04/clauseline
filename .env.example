# ── LLMs ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Correct model IDs as of 2026 — dateless for Sonnet, dated for Haiku
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── Embeddings ───────────────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...
# voyage-law-2 is the domain-specific alt; swap here to test
VOYAGE_MODEL=voyage-3-large

# ── Reranker ─────────────────────────────────────────────────────────────────
COHERE_API_KEY=...
COHERE_RERANK_MODEL=rerank-3

# ── Parsing (optional — fallback for scans/complex layouts) ──────────────────
# Uncomment when wiring LlamaParse fallback in Week 1
# LLAMA_CLOUD_API_KEY=llx-...

# ── Postgres (ParadeDB) ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clauseline
POSTGRES_PASSWORD=clauseline
POSTGRES_DB=clauseline
# asyncpg driver required for SQLAlchemy async sessions
DATABASE_URL=postgresql+asyncpg://clauseline:clauseline@localhost:5432/clauseline

# ── Langfuse ─────────────────────────────────────────────────────────────────
# Langfuse cloud is the default; self-hosted instructions in docker/README.md
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Retrieval knobs — see docs/decision-log.md for why these defaults
RRF_K=60
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RERANK_TOP_K=8
